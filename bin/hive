#!/usr/bin/env bash
# hive — entry point. Resolves the Python venv from the global install,
# delegates to lib/hive_cli/main.py.
#
# HIVE_INSTALL_DIR — global install (~/.local/share/hive). Holds the venv,
#                    MCP server source, CLI source, dashboard source, and
#                    all tool scripts. Projects use these directly; no
#                    per-project .hive/ copy is needed.

set -euo pipefail

SCRIPT="$(readlink -f "$0")"
HIVE_INSTALL_DIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
export HIVE_INSTALL_DIR

VENV_PY="$HIVE_INSTALL_DIR/venv/bin/python"
if [ ! -x "$VENV_PY" ]; then
  echo "hive: venv not found at $HIVE_INSTALL_DIR/venv. Run $HIVE_INSTALL_DIR/packaging/install.sh" >&2
  exit 1
fi

# HIVE_ROOT is the global install — projects use installed scripts directly.
export HIVE_ROOT="$HIVE_INSTALL_DIR"
# Legacy alias many scripts still consult before falling back to walk-up.
export SKILL_DIR="$HIVE_ROOT"

export PYTHONPATH="$HIVE_INSTALL_DIR/lib${PYTHONPATH:+:$PYTHONPATH}"

exec "$VENV_PY" -m hive_cli.main "$@"
