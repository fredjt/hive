#!/usr/bin/env bash
# docker-build — build the hive-claude Docker image
#
# Copies the running claude binary into the build context and builds the image.
# Usage:
#   bin/docker-build              # build default image
#   bin/docker-build 0.5.14       # tag with version
#   bin/docker-build --push       # build and push
#
# Prerequisites:
#   - claude CLI on PATH (or set CLAUDE_BIN)
#   - Docker running
#   - ANTHROPIC_API_KEY set (the binary needs it at build time to verify license)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
IMAGE="hive-claude"
VERSION="${1:-latest}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
BUILD_CTX="$(mktemp -d)"
trap 'rm -rf "$BUILD_CTX"' EXIT

# Find the claude binary
if ! command -v "$CLAUDE_BIN" &>/dev/null; then
    echo "ERROR: claude CLI not found on PATH" >&2
    exit 1
fi

CLAUDE_PATH="$(command -v "$CLAUDE_BIN")"
# Follow symlinks to get the real binary
CLAUDE_REAL="$(readlink -f "$CLAUDE_PATH")"

echo "Using claude binary: $CLAUDE_REAL ($(du -h "$CLAUDE_REAL" | cut -f1))"

# Copy the binary into the build context
cp "$CLAUDE_REAL" "$BUILD_CTX/claude"

# Copy the Dockerfile and .dockerignore
cp "$SCRIPT_DIR/../Dockerfile" "$BUILD_CTX/"
cp "$SCRIPT_DIR/../.dockerignore" "$BUILD_CTX/" 2>/dev/null || true

echo "Building $IMAGE:$VERSION ..."
docker build -t "$IMAGE:$VERSION" "$BUILD_CTX"

if [ "${2:-}" = "--push" ]; then
    echo "Pushing $IMAGE:$VERSION ..."
    docker push "$IMAGE:$VERSION"
fi

echo ""
echo "Image built: $IMAGE:$VERSION"
docker images "$IMAGE" --format "  {{.Repository}}:{{.Tag}}  {{.Size}}"
