# Runtime state — per-project, never committed
.company
.worktrees

# Local config overrides
etc/config.toml

# Node
node_modules/

# Build & test litter — a normal build-and-test cycle never leaves untracked noise
# dist/ = build-package.sh output (hive-<version>.tar.gz + .sha256 sidecars)
# .coverage = pytest --cov, .pytest_cache = pytest cache dir
# unsloth-tmp/ = TMPDIR redirect target (pytest tmp dirs land here)
dist/
.coverage
.pytest_cache/
unsloth-tmp/

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local planning — never committed
RELEASE_GOALS.md

# Local tooling state — never committed (sandbox/dev runtime dirs;
# these may hold credentials or caches and must stay out of the repo)
.cache/
.config/
.docker/
.local/
.gitconfig
.unsloth_attachments/

# Hive scaffold (tweakable per-project; see negation entries below to track specific tweaks)
.hive
# To track a specific scaffold tweak, add a negation entry, e.g.:
#   !.hive/agents/ceo.md       # track your customized CEO prompt
#   !.hive/lib/tools/custom-*.sh
# Or wholesale track the scaffold by commenting out the `.hive` line above.
